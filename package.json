{
  "name": "@drakaniia/codebase-health",
  "version": "2.0.0",
  "description": "Language-agnostic agent skills for keeping codebases healthy — audit structure, execute refactoring, prevent decay, and enforce clean code design.",
  "keywords": [
    "agent-skills",
    "codebase-health",
    "audit-codebase",
    "folder-architecture",
    "code-design",
    "refactoring"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./.opencode/plugins/codebase-health.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    ".opencode/plugins/codebase-health.js",
    "assets/",
    "hooks/",
    "skills/",
    "_shared/references/",
    "LICENSE",
    "readme.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "validate": "node scripts/build.mjs --validate-only",
    "check-opencode": "node scripts/check-opencode.mjs",
    "sync-refs": "bash _shared/scripts/sync-references.sh",
    "check-versions": "node _shared/scripts/bump-version.mjs --check",
    "bump": "node _shared/scripts/bump-version.mjs"
  },
  "devDependencies": {
    "skills-ref": "^0.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drakaniia/codebase-health.git"
  }
}
