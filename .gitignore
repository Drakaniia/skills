# Python virtual environment
.venv/

# Node.js
node_modules/

# OpenCode plugins — local dev scratch, not shipped.
# codebase-health.js IS the published OpenCode adapter, so it is re-included.
# The pattern must be the bare filename, not plugins/*: git never descends into
# an excluded directory, so a negation below it cannot re-include anything.
.opencode/plugins/*.js
!.opencode/plugins/codebase-health.js
.opencode/package.json
.opencode/package-lock.json

# OpenCode session data
.omo/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Generated by _shared/scripts/sync-references.sh — canonical source is
# _shared/references/. Not committed: regenerate with `npm run build`.
# Listed per-filename, not as skills/*/references/, so the real per-skill
# references (REFERENCE.md, REPORT-TEMPLATE.md) stay tracked.
skills/*/references/ORGANIZATION-PATTERNS.md
skills/*/references/SPLITTING-GUIDE.md
